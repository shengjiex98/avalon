{
  "name": "avalon",
  "version": "1.0.0",
  "description": "Self-hosted online Avalon (The Resistance) with English and Chinese UI",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:browser": "node scripts/build-browser.mjs",
    "start": "npm run build:browser && node src/server.js",
    "test": "npm run build:browser && node --test \"test/**/*.test.js\" \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "4.5.4"
  }
}

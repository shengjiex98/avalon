# The controller installer owns this timer outside the source checkout.

[Unit]
Description=Poll GitHub main for Avalon deployments

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
# Hourly is deliberately unhurried: CI delivers the fast path, and every run
# that finds a game in progress is a run that did nothing useful.
Persistent=true

[Install]
WantedBy=timers.target

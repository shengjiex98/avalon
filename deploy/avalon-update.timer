# Install without copying, so the timer stays version-controlled:
#   systemctl --user link  %h/avalon/deploy/avalon-update.service
#   systemctl --user link  %h/avalon/deploy/avalon-update.timer
#   systemctl --user enable --now avalon-update.timer

[Unit]
Description=Poll origin/main for Avalon deployments

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
# Hourly is deliberately unhurried: CI delivers the fast path, and every run
# that finds a game in progress is a run that did nothing useful.
Persistent=true

[Install]
WantedBy=timers.target

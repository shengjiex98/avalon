# The controller installer owns this unit outside the source checkout.
#   systemctl --user enable --now avalon
#   loginctl enable-linger "$USER"        # survive logout / reboot
#
# Host-specific settings (PORT, HOST) go in ~/.config/avalon.env,
# which is deliberately outside the repo.
# The server always accepts the official shengjiex98.github.io client.
#
# Deployments arrive from CI, with avalon-update.timer as the hourly fallback;
# state-compatible updates can restart during a game without losing it.

[Unit]
Description=Avalon game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/avalon/current
EnvironmentFile=-%h/.config/avalon.env
Environment=PORT=8420
# An absolute path, not `env node`: the runtime is hand-installed under
# ~/.local. The release manifest and controller both require Node 24.
# Node normally resolves the current symlink before assigning import.meta.url.
# Preserve the entrypoint path so the server's direct-execution guard sees the
# same path as process.argv[1] and actually starts listening.
ExecStart=%h/.local/bin/node --preserve-symlinks-main %h/.local/lib/avalon/current/src/server.js
Restart=on-failure
RestartSec=3

# Room snapshots live in the service-managed state directory.
StateDirectory=avalon
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target

# Permanently installed by deploy/install-updater.sh. Application releases do
# not replace systemd units.
[Unit]
Description=Avalon game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/avalon/current
EnvironmentFile=-%h/.config/avalon.env
Environment=PORT=8420
ExecStart=%h/.local/bin/node --preserve-symlinks-main %h/.local/lib/avalon/current/src/server.js
Restart=on-failure
RestartSec=3
StateDirectory=avalon
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target

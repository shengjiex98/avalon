# Permanently installed by deploy/install-updater.sh. Application releases do
# not replace systemd units.
[Unit]
Description=Avalon game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/avalon/current
EnvironmentFile=-%h/.config/avalon.env
Environment=PORT=8420
ExecStart=%h/.local/bin/node %h/.local/lib/avalon/current/src/server/main.ts
Restart=on-failure
RestartSec=3
# Pinned rather than left to StateDirectory=, whose user-unit path moved
# between systemd versions. deploy/updater.sh derives the same location for the
# snapshot it backs up, and test/deploy.test.js holds the two together.
Environment=XDG_STATE_HOME=%h/.local/state
ReadWritePaths=%h/.local/state/avalon
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target

# Reconcile the host with the stable release pointer.
[Unit]
Description=Update the Avalon server from its published release pointer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/avalon.env
ExecStart=%h/.local/libexec/avalon-deploy/updater.sh reconcile
SuccessExitStatus=75

# Permanently installed by deploy/install-updater.sh.
[Unit]
Description=Wait for Avalon deployment triggers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/avalon.env
ExecStart=%h/.local/bin/node %h/.local/libexec/avalon-deploy/listen.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
